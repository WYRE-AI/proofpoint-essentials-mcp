# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service leaves these unset and has no env_file.
PROOFPOINT_ESSENTIALS_USERNAME=
PROOFPOINT_ESSENTIALS_PASSWORD=
# Region subdomain. Not a credential. Default us1. Gateway requests may send
# X-Proofpoint-Essentials-Region instead.
PROOFPOINT_ESSENTIALS_REGION=us1

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address when MCP_TRANSPORT=http. When MCP_HTTP_HOST is unset, the
# HTTP server binds 127.0.0.1. The container image sets 0.0.0.0 and requires
# CONDUIT_S2S_SECRET. Without a secret, the listener is 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (changeme,
# secret, placeholder, your-s2s-secret, replace-with-a-real-secret, and the
# same list in src/index.ts), so a copied example cannot forge X-Gateway-S2S.
# docker compose will not start when it is unset or empty. Never commit a
# real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check
# X-Gateway-S2S, and binds 127.0.0.1 even if MCP_HTTP_HOST is a wider
# address such as 0.0.0.0. A known placeholder is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Proofpoint-Essentials-Username and X-Proofpoint-Essentials-Password
# headers; X-Proofpoint-Essentials-Region is optional; no env fallback).
# The container image and compose file set gateway. Stdio ignores this and
# reads PROOFPOINT_ESSENTIALS_* from the environment.
# AUTH_MODE=env

LOG_LEVEL=info
